#!/usr/bin/env bash
# Carregado pelos painéis do Azure DevOps. Não é para ser chamado direto.
_workdeck_load_azure() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck/azure.conf"
  if [ ! -f "$config" ]; then
    echo "configure o Azure DevOps primeiro:"
    echo "  cp azure.example.conf \"$config\""
    return 1
  fi
  # shellcheck source=/dev/null
  . "$config"
  if ! command -v az >/dev/null; then
    echo "instale o az cli: brew install azure-cli"
    return 1
  fi
  if [ -z "${AZDO_ORG:-}" ]; then
    echo "AZDO_ORG não está definido em $config"
    return 1
  fi
  return 0
}
