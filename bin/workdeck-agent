#!/usr/bin/env bash
set -uo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"

load_config() { AGENT_CMD="$(setting_get AGENT_CMD)"; }

is_workdeck_command() {
  case "$(basename "${1%% *}")" in
    work|work-panel|workdeck-*|help) return 0 ;;
  esac
  return 1
}

agent_problem() {
  local name="${1%% *}"
  if [ -z "$1" ]; then msgln agent_none
  elif is_workdeck_command "$1"; then msgln agent_is_workdeck "$1"
  elif ! type -P "$name" >/dev/null; then msgln agent_not_in_path "$name"
  fi
  return 0
}

uuid_for() {
  local h
  h="$(printf '%s' "$1" | git hash-object --stdin)"
  printf '%s-%s-4%s-8%s-%s\n' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}

panes() { tmux list-panes ${TMUX_PANE:+-t "$TMUX_PANE"} -F "$1"; }

agent_in_window() {
  local id tty role c
  [ -n "${TMUX:-}" ] || return 0
  while IFS='|' read -r id tty role; do
    case "$role" in REVIEW*) continue ;; esac
    for c in $(ps -o comm= -t "${tty#/dev/}" 2>/dev/null | awk -F/ '{print $NF}'); do
      case " $KNOWN_AGENTS " in *" $c "*) echo "$id $c"; return 0 ;; esac
    done
  done < <(panes '#{pane_id}|#{pane_tty}|#{@role}')
  return 0
}

send_request() {
  local file="$1" title="$2" key="$3" name cmd id open open_key target="" pane text active p review_cmd
  load_config
  review_cmd="$(setting_get REVIEW_AGENT_CMD)"
  active="$(agent_in_window)"
  if [ -n "$active" ]; then
    target="${active%% *}"
    [ "$(basename "${AGENT_CMD%% *}")" = "${active#* }" ] || AGENT_CMD="${active#* }"
  fi
  [ -z "$review_cmd" ] || AGENT_CMD="$review_cmd"
  p="$(agent_problem "$AGENT_CMD")"
  if [ -n "$p" ]; then
    msgln agent_unknown
    return 1
  fi
  name="$(basename "${AGENT_CMD%% *}")"

  if [ -n "${TMUX:-}" ]; then
    read -r open open_key < <(panes '#{pane_id}|#{@role}|#{@key}' |
      awk -F'|' -v t="$title" '$2 == t || index($2, t " ") == 1 {print $1, $3; exit}')
    if [ -n "${open:-}" ] && [ "${open_key:-}" = "$key" ]; then
      tmux load-buffer -b workdeck-request "$file"
      tmux paste-buffer -p -d -b workdeck-request -t "$open"
      sleep 0.5
      tmux send-keys -t "$open" Enter
      tmux select-pane -t "$open"
      return 0
    fi
    [ -n "${open:-}" ] && tmux kill-pane -t "$open"
  fi

  text="\"\$(cat '$file')\""
  case "$name" in
    claude)
      if [ -n "$key" ]; then
        id="$(uuid_for "$key")"
        cmd="if find \"\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}/projects\" -maxdepth 2 -name '$id.jsonl' 2>/dev/null | grep -q .; then exec $AGENT_CMD --resume $id $text; else exec $AGENT_CMD --session-id $id $text; fi"
      else
        cmd="$AGENT_CMD $text"
      fi ;;
    codex) cmd="$AGENT_CMD $text" ;;
    gemini) cmd="$AGENT_CMD -i $text" ;;
    *)
      cmd="$AGENT_CMD"
      if command -v pbcopy >/dev/null; then pbcopy < "$file"
      elif command -v wl-copy >/dev/null; then wl-copy < "$file"
      elif command -v xclip >/dev/null; then xclip -selection clipboard < "$file"
      fi
      msgln agent_clipboard "$file" ;;
  esac

  if [ -z "${TMUX:-}" ]; then
    exec bash -c "$cmd"
  fi
  target="${target:-${TMUX_PANE:-}}"
  pane="$(tmux split-window -v -l 40% ${target:+-t "$target"} ${CLAUDE_CONFIG_DIR:+-e "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR"} -P -F '#{pane_id}' -c "$PWD" "$cmd")"
  tmux set -p -t "$pane" @role "$title · $name"
  tmux set -p -t "$pane" @key "$key"
}

send_to_pane() {
  printf '%s' "$2" | tmux load-buffer -b workdeck-request -
  tmux paste-buffer -p -d -b workdeck-request -t "$1"
  tmux select-pane -t "$1"
}

claude_prompt() {
  tmux capture-pane -p -e -t "$1" | LC_ALL=C awk '
    {
      line = $0
      gsub(/\033\[2m/, "\001", line)
      gsub(/\033\[[0-9;]*m/, "", line)
      gsub(/\302\240/, " ", line)
      if (substr(line, 1, 3) != "\342\235\257") next
      rest = substr(line, 4)
      sub(/^ +/, "", rest)
      sub(/ +$/, "", rest)
      found = 1
      last = rest
    }
    END { if (found) print "prompt:" last; else print "none" }'
}

claude_state() {
  local prompt
  if tmux capture-pane -p -t "$1" | LC_ALL=C awk "$SCREEN_BUSY_AWK"' { s = s $0 "\n" } END { exit !screen_busy(s) }'; then echo busy; return 0; fi
  prompt="$(claude_prompt "$1")"
  case "$prompt" in
    "prompt:"|"prompt:"$'\001'*) echo ready ;;
    *) echo blocked ;;
  esac
}

submit_to_claude() {
  local pane="$1" text="$2" n=0
  send_to_pane "$pane" "$text"
  while [ "$n" -lt 10 ]; do
    if [ "$(claude_prompt "$pane")" = "prompt:$text" ]; then
      tmux send-keys -t "$pane" Enter
      return 0
    fi
    sleep 0.1
    n=$((n + 1))
  done
  return 3
}

case "${1:-}" in
  --active)
    agent_in_window
    exit 0
    ;;
  --send)
    send_to_pane "${2:?use: workdeck-agent --send <painel> <texto>}" "${3:?use: workdeck-agent --send <painel> <texto>}"
    exit $?
    ;;
  --claude-state)
    claude_state "${2:?use: workdeck-agent --claude-state <painel>}"
    exit 0
    ;;
  --submit)
    submit_to_claude "${2:?use: workdeck-agent --submit <painel> <texto>}" "${3:?use: workdeck-agent --submit <painel> <texto>}"
    exit $?
    ;;
  --check)
    load_config
    p="$(agent_problem "$AGENT_CMD")"
    [ -z "$p" ] && exit 0
    echo "$p"
    exit 1
    ;;
  --request)
    send_request "${2:?use: workdeck-agent --request <arquivo> [título] [chave]}" "${3:-REVIEW}" "${4:-}"
    exit $?
    ;;
  --set)
    cmd="${2:?use: workdeck-agent --set <comando>}"
    is_workdeck_command "$cmd" && { msgln agent_set_is_workdeck "$cmd"; exit 1; }
    type -P "${cmd%% *}" >/dev/null || { msgln agent_set_not_in_path "${cmd%% *}"; exit 1; }
    setting_set AGENT_CMD "$cmd"
    msgln agent_set_done "$cmd"
    exit 0
    ;;
esac
