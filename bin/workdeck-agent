#!/usr/bin/env bash
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"
CONFIG="$CONFIG_DIR/agent.conf"
CONHECIDOS="claude codex copilot aider gemini opencode cursor-agent crush goose q"

carrega() { AGENT_CMD=""; [ -f "$CONFIG" ] && . "$CONFIG"; }

do_workdeck() {
  case "$(basename "${1%% *}")" in
    work|work-panel|workdeck-*|git-review|help) return 0 ;;
  esac
  return 1
}

problema() {
  local nome="${1%% *}"
  if [ -z "$1" ]; then echo "nenhum agente definido"
  elif do_workdeck "$1"; then echo "'$1' é um comando do workdeck, não um agente"
  elif ! type -P "$nome" >/dev/null; then echo "'$nome' não está no PATH"
  fi
  return 0
}

uuid_de() {
  local h
  h="$(printf '%s' "$1" | git hash-object --stdin)"
  printf '%s-%s-4%s-8%s-%s\n' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}

panes() { tmux list-panes ${TMUX_PANE:+-t "$TMUX_PANE"} -F "$1"; }

pane_do_agente() {
  local id tty papel
  while IFS='|' read -r id tty papel; do
    case "$papel" in REVIEW*) continue ;; esac
    if ps -o comm= -t "${tty#/dev/}" 2>/dev/null | awk -F/ '{print $NF}' | grep -qx "$1"; then
      echo "$id"
      return 0
    fi
  done < <(panes '#{pane_id}|#{pane_tty}|#{@papel}')
  return 0
}

pedido() {
  local arquivo="$1" titulo="$2" chave="$3" nome cmd id aberto chave_aberta alvo painel texto
  carrega
  local p
  p="$(problema "$AGENT_CMD")"
  if [ -n "$p" ]; then
    echo "$p — defina a sua IA com: work agent <comando>"
    return 1
  fi
  nome="$(basename "${AGENT_CMD%% *}")"

  if [ -n "${TMUX:-}" ]; then
    read -r aberto chave_aberta < <(panes '#{pane_id}|#{@papel}|#{@chave}' |
      awk -F'|' -v t="$titulo" '$2 == t || index($2, t " ") == 1 {print $1, $3; exit}')
    if [ -n "${aberto:-}" ] && [ "${chave_aberta:-}" = "$chave" ]; then
      tmux load-buffer -b workdeck-pedido "$arquivo"
      tmux paste-buffer -p -d -b workdeck-pedido -t "$aberto"
      sleep 0.5
      tmux send-keys -t "$aberto" Enter
      tmux select-pane -t "$aberto"
      return 0
    fi
    [ -n "${aberto:-}" ] && tmux kill-pane -t "$aberto"
  fi

  texto="\"\$(cat '$arquivo')\""
  case "$nome" in
    claude)
      if [ -n "$chave" ]; then
        id="$(uuid_de "$chave")"
        cmd="if find \"\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}/projects\" -maxdepth 2 -name '$id.jsonl' 2>/dev/null | grep -q .; then exec $AGENT_CMD --resume $id $texto; else exec $AGENT_CMD --session-id $id $texto; fi"
      else
        cmd="$AGENT_CMD $texto"
      fi ;;
    codex) cmd="$AGENT_CMD $texto" ;;
    gemini) cmd="$AGENT_CMD -i $texto" ;;
    *)
      cmd="$AGENT_CMD"
      if command -v pbcopy >/dev/null; then pbcopy < "$arquivo"
      elif command -v wl-copy >/dev/null; then wl-copy < "$arquivo"
      elif command -v xclip >/dev/null; then xclip -selection clipboard < "$arquivo"
      fi
      echo "o pedido está na área de transferência e em $arquivo: cole na IA que vai abrir." ;;
  esac

  if [ -z "${TMUX:-}" ]; then
    exec bash -c "$cmd"
  fi
  alvo="$(pane_do_agente "$nome")"
  alvo="${alvo:-${TMUX_PANE:-}}"
  painel="$(tmux split-window -v -l 40% ${alvo:+-t "$alvo"} ${CLAUDE_CONFIG_DIR:+-e "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR"} -P -F '#{pane_id}' -c "$PWD" "$cmd")"
  tmux set -p -t "$painel" @papel "$titulo · $nome"
  tmux set -p -t "$painel" @chave "$chave"
  tmux set -w -t "$painel" @ia 1
}

case "${1:-}" in
  --check)
    carrega
    p="$(problema "$AGENT_CMD")"
    [ -z "$p" ] && exit 0
    echo "$p"
    exit 1
    ;;
  --pedido)
    pedido "${2:?use: workdeck-agent --pedido <arquivo> [título] [chave]}" "${3:-REVIEW}" "${4:-}"
    exit $?
    ;;
  --set)
    cmd="${2:?use: work agent <comando>}"
    nome="${cmd%% *}"
    if do_workdeck "$nome"; then
      echo "'$nome' é um comando do próprio workdeck, não um agente de IA."
      echo "Use o comando do seu agente, por exemplo: work agent claude"
      exit 1
    fi
    type -P "$nome" >/dev/null || {
      echo "'$nome' não está no PATH. Instale primeiro, ou use outro comando."
      exit 1
    }
    mkdir -p "$CONFIG_DIR"
    printf 'AGENT_CMD="%s"\n' "$cmd" > "$CONFIG"
    echo "agente definido: $cmd"
    exit 0
    ;;
  --show)
    carrega
    [ -n "$AGENT_CMD" ] && echo "$AGENT_CMD" || echo "nenhum agente configurado"
    exit 0
    ;;
  --list)
    echo "Agentes conhecidos encontrados no PATH:"
    achou=0
    for c in $CONHECIDOS; do
      command -v "$c" >/dev/null && { echo "  $c"; achou=1; }
    done
    [ "$achou" = 0 ] && echo "  nenhum"
    echo
    echo "Qualquer CLI serve, não só estas. Para definir:"
    echo "  work agent <comando>"
    exit 0
    ;;
esac

carrega
cat <<FIM
work agent — qual IA o work review usa.

  Sua IA: ${AGENT_CMD:-nenhuma ainda}

  work agent claude       define (precisa estar instalada)
  work agent              mostra a atual
  work agent --list       procura agentes conhecidos no PATH
FIM
