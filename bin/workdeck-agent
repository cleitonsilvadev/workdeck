#!/usr/bin/env bash
# workdeck-agent — abre o seu agente de IA num pane ao lado, ou configura qual é.
#
#   workdeck-agent              abre o agente num pane ao lado
#   workdeck-agent --here       roda o agente no pane atual
#   workdeck-agent --set <cmd>  define qual comando é o seu agente
#   workdeck-agent --show       mostra o configurado
#   workdeck-agent --list       procura agentes conhecidos no PATH
#
# O comando pode ter argumentos: workdeck-agent --set "aider --no-auto-commits"
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"
CONFIG="$CONFIG_DIR/agent.conf"
CONHECIDOS="claude codex copilot aider gemini opencode cursor-agent crush goose q"

carrega() { AGENT_CMD=""; AGENT_SPLIT="${AGENT_SPLIT:-h}"; [ -f "$CONFIG" ] && . "$CONFIG"; }

do_workdeck() {
  case "$(basename "${1%% *}")" in
    work|work-panel|workdeck-*|git-review|ai|help) return 0 ;;
  esac
  return 1
}

problema() {
  local nome="${1%% *}"
  if [ -z "$1" ]; then echo "nenhum agente definido"
  elif do_workdeck "$1"; then echo "'$1' é um comando do workdeck, não um agente"
  elif ! type -P "$nome" >/dev/null; then echo "'$nome' não está no PATH"
  fi
  return 0
}

case "${1:-}" in
  --check)
    carrega
    p="$(problema "$AGENT_CMD")"
    [ -z "$p" ] && exit 0
    echo "$p"
    exit 1
    ;;
  --set)
    cmd="${2:?use: work agent <comando>}"
    nome="${cmd%% *}"
    if do_workdeck "$nome"; then
      echo "'$nome' é um comando do próprio workdeck, não um agente de IA."
      echo "Use o comando do seu agente, por exemplo: work agent claude"
      exit 1
    fi
    type -P "$nome" >/dev/null || {
      echo "'$nome' não está no PATH. Instale primeiro, ou use outro comando."
      exit 1
    }
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG" <<FIM
# Qual agente de IA o workdeck abre. Pode ter argumentos.
AGENT_CMD="$cmd"
# Como dividir o pane: h lado a lado, v em cima/embaixo.
AGENT_SPLIT="${AGENT_SPLIT:-h}"
FIM
    echo "agente definido: $cmd"
    exit 0
    ;;
  --show)
    carrega
    [ -n "$AGENT_CMD" ] && echo "$AGENT_CMD" || echo "nenhum agente configurado"
    exit 0
    ;;
  --list)
    echo "Agentes conhecidos encontrados no PATH:"
    achou=0
    for c in $CONHECIDOS; do
      command -v "$c" >/dev/null && { echo "  $c"; achou=1; }
    done
    [ "$achou" = 0 ] && echo "  nenhum"
    echo
    echo "Qualquer CLI serve, não só estas. Para definir:"
    echo "  work agent <comando>"
    exit 0
    ;;
  -h|--help|help)
    carrega
    atual="${AGENT_CMD:-nenhum ainda — defina com: work agent <comando>}"
    cat <<FIM
ai — abre a IA ao lado, na pasta em que você está, para te ajudar no projeto.

  Seu agente: $atual

  Onde você está          O que acontece
  dentro do work          divide a janela e abre o agente à direita, na mesma pasta
  fora do tmux            roda o agente ali mesmo, no terminal atual
  sem agente definido     explica como definir e lista os que achou no PATH

  Exemplo: no projeto api, digite ai. O agente abre ao lado já em ~/code/api, e
  do outro lado fica o shell para rodar work review e ver o que ele mudou.

  ai  ou  Ctrl+b a        abre o agente
  work agent claude       define qual é o seu agente (precisa estar instalado)
  work agent              mostra o atual
  work agent --list       procura agentes conhecidos no PATH
  ai --here               abre no painel atual, sem dividir

  O ai não repassa texto: ai corrige o login só abre o agente; escreva lá dentro.
  Para abrir embaixo em vez de ao lado, troque AGENT_SPLIT="h" por "v" em
  ${CONFIG/#$HOME/~}
FIM
    exit 0
    ;;
esac

carrega
if [ -z "$AGENT_CMD" ] && [ ! -t 1 ] && [ -n "${TMUX:-}" ]; then
  tmux display-message -d 6000 "nenhum agente de IA configurado — rode: work agent <comando>"
  exit 0
fi
if [ -z "$AGENT_CMD" ]; then
  echo "Nenhum agente configurado."
  echo
  "$0" --list
  exit 1
fi

p="$(problema "$AGENT_CMD")"
if [ -n "$p" ]; then
  if [ ! -t 1 ] && [ -n "${TMUX:-}" ]; then
    tmux display-message -d 6000 "$p — troque com: work agent <comando>"
    exit 0
  fi
  echo "$p — troque com: work agent <comando>"
  exit 1
fi

if [ "${1:-}" = "--here" ] || [ -z "${TMUX:-}" ]; then
  if [ -n "${TMUX:-}" ]; then
    tmux set -p @papel "IA · ${AGENT_CMD%% *}"
    tmux set -w @ia 1
  fi
  exec $AGENT_CMD
fi

flag="-h"; [ "${AGENT_SPLIT:-h}" = "v" ] && flag="-v"
painel="$(tmux split-window "$flag" -P -F '#{pane_id}' -c "#{pane_current_path}" "$AGENT_CMD")"
tmux set -p -t "$painel" @papel "IA · ${AGENT_CMD%% *}"
tmux set -w -t "$painel" @ia 1
