#!/usr/bin/env bash
# work — abre (ou volta para) a sessão tmux de trabalho, com uma janela por projeto.
#
# Uso: work             abre/volta para a sessão; na primeira vez, pergunta os projetos
#      work <janela>    abre e já vai para a janela com esse nome
#      work escolher    escolhe de novo os projetos da sessão
#      work kill        fecha a sessão inteira
#
# Os projetos vêm de ~/.config/workdeck/projects.conf — uma linha por janela.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck/projects.conf"
SESSION="${WORKDECK_SESSION:-work}"

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

atividade() {
  local t
  t="$(mtime "$1/.git/index")"
  [ "$t" != 0 ] || t="$(mtime "$1/.git")"
  echo "$t"
}

curto() { case "$1" in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }

resolver() {
  local dir="${1/#\~/$HOME}"
  dir="${dir//\$\{HOME\}/$HOME}"
  echo "${dir//\$HOME/$HOME}"
}

quando() {
  local dias=$(( ($(date +%s) - $1) / 86400 ))
  if [ "$1" = 0 ]; then echo ""
  elif [ $dias -le 0 ]; then echo "hoje"
  elif [ $dias = 1 ]; then echo "ontem"
  elif [ $dias -lt 30 ]; then echo "há $dias dias"
  elif [ $dias -lt 365 ]; then echo "há $((dias / 30)) meses"
  else echo "há $((dias / 365)) anos"
  fi
}

descobrir() {
  find "$HOME" -maxdepth 4 \
    \( -name node_modules -o -name Library -o -name Applications -o -name Downloads \
       -o -name Pictures -o -name Music -o -name Movies -o -name Public \) -prune \
    -o \( -name '.*' ! -name .git \) -prune \
    -o -name .git -print -prune 2>/dev/null |
  while IFS= read -r g; do
    d="${g%/.git}"
    [ "$d" = "$HOME" ] && continue
    echo "$(atividade "$d")|$d"
  done | sort -t'|' -k1,1rn
}

ler_config() {
  windows=()
  [ -f "$CONFIG" ] || return 0
  while IFS= read -r line; do
    line="${line%%#*}"                    # tira comentário
    line="$(echo "$line" | sed 's/[[:space:]]*$//')"
    [ -z "$line" ] && continue
    windows+=("$line")
  done < "$CONFIG"
}

algum_projeto_existe() {
  local entry name dir cmd
  for entry in ${windows[@]+"${windows[@]}"}; do
    IFS="|" read -r name dir cmd <<< "$entry"
    [ -d "$(resolver "$dir")" ] && return 0
  done
  return 1
}

P_DIR=(); P_TS=(); P_MARK=()

ja_na_lista() {
  local i
  for ((i = 0; i < ${#P_DIR[@]}; i++)); do
    [ "${P_DIR[$i]}" = "$1" ] && return 0
  done
  return 1
}

montar_lista() {
  local atuais=() entry name dir cmd ts d i
  ler_config
  for entry in ${windows[@]+"${windows[@]}"}; do
    IFS="|" read -r name dir cmd <<< "$entry"
    [ -n "$cmd" ] && continue
    d="$(resolver "$dir")"
    [ -d "$d" ] && atuais+=("$d")
  done
  for d in ${atuais[@]+"${atuais[@]}"}; do
    P_DIR+=("$d"); P_TS+=("$(atividade "$d")"); P_MARK+=(1)
  done
  while IFS="|" read -r ts d; do
    [ -n "$d" ] || continue
    ja_na_lista "$d" && continue
    P_DIR+=("$d"); P_TS+=("$ts")
    if [ ${#atuais[@]} = 0 ] && [ ${#P_DIR[@]} -le 5 ]; then P_MARK+=(1); else P_MARK+=(0); fi
  done < <(descobrir)
}

nome_de() { basename "$1" | tr ' |' '--'; }

desenhar() {
  local altura fim i marca linha n=${#P_DIR[@]}
  altura=$(( $(tput lines 2>/dev/null || echo 24) - 5 ))
  [ $altura -ge 3 ] || altura=3
  if [ $cur -lt $top ]; then top=$cur; fi
  if [ $cur -ge $((top + altura)) ]; then top=$((cur - altura + 1)); fi
  fim=$((top + altura))
  [ $fim -le $n ] || fim=$n
  printf '\033[H\033[2J'
  printf '  Escolha os projetos do seu work\n'
  printf '  \033[2m↑↓ move · espaço marca · a marca todos · enter confirma · q sai\033[0m\n\n'
  for ((i = top; i < fim; i++)); do
    marca=' '
    [ "${P_MARK[$i]}" = 1 ] && marca='x'
    linha="$(printf '[%s] %-20.20s %-42.42s %s' "$marca" "$(nome_de "${P_DIR[$i]}")" "$(curto "${P_DIR[$i]}")" "$(quando "${P_TS[$i]}")")"
    if [ $i = $cur ]; then printf '  \033[7m%s\033[0m\n' "$linha"; else printf '  %s\n' "$linha"; fi
  done
  if [ $fim -lt $n ]; then printf '  \033[2m… mais %s abaixo\033[0m\n' $((n - fim)); fi
  return 0
}

gravar() {
  local i d nome usados=" " extras=() entry name dir cmd tmp
  ler_config
  for entry in ${windows[@]+"${windows[@]}"}; do
    IFS="|" read -r name dir cmd <<< "$entry"
    [ -n "$cmd" ] && extras+=("$entry")
  done
  [ ${#extras[@]} -gt 0 ] || extras=("painel|~|work-panel")
  mkdir -p "$(dirname "$CONFIG")"
  tmp="$(mktemp)"
  for ((i = 0; i < ${#P_DIR[@]}; i++)); do
    [ "${P_MARK[$i]}" = 1 ] || continue
    d="${P_DIR[$i]}"
    nome="$(nome_de "$d")"
    case "$usados" in *" $nome "*) nome="$(nome_de "$(dirname "$d")")-$nome" ;; esac
    usados="$usados$nome "
    echo "$nome|$(curto "$d")" >> "$tmp"
  done
  printf '%s\n' "${extras[@]}" >> "$tmp"
  mv "$tmp" "$CONFIG"
}

escolher() {
  local tecla resto i n marcados
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "work escolher precisa de um terminal interativo."
    return 1
  fi
  echo "procurando repositórios git em ~ ..."
  montar_lista
  n=${#P_DIR[@]}
  if [ $n = 0 ]; then
    echo "não achei nenhum repositório git em ~ (até 4 níveis)."
    echo "acrescente seus projetos em $CONFIG, uma linha por janela: nome|caminho"
    return 1
  fi
  cur=0; top=0
  printf '\033[?1049h\033[?25l'
  trap 'printf "\033[?25h\033[?1049l"' EXIT
  while true; do
    desenhar
    IFS= read -rsn1 tecla || tecla=q
    case "$tecla" in
      $'\033')
        IFS= read -rsn2 resto || resto=""
        case "$resto" in
          '[A') [ $cur -gt 0 ] && cur=$((cur - 1)) ;;
          '[B') [ $cur -lt $((n - 1)) ] && cur=$((cur + 1)) ;;
        esac ;;
      k) [ $cur -gt 0 ] && cur=$((cur - 1)) ;;
      j) [ $cur -lt $((n - 1)) ] && cur=$((cur + 1)) ;;
      ' ') if [ "${P_MARK[$cur]}" = 1 ]; then P_MARK[$cur]=0; else P_MARK[$cur]=1; fi ;;
      a)
        marcados=0
        for ((i = 0; i < n; i++)); do [ "${P_MARK[$i]}" = 1 ] && marcados=$((marcados + 1)); done
        for ((i = 0; i < n; i++)); do if [ $marcados = $n ]; then P_MARK[$i]=0; else P_MARK[$i]=1; fi; done ;;
      '') break ;;
      q) printf '\033[?25h\033[?1049l'; trap - EXIT; echo "nada mudou."; return 1 ;;
    esac
  done
  printf '\033[?25h\033[?1049l'
  trap - EXIT
  marcados=0
  for ((i = 0; i < n; i++)); do [ "${P_MARK[$i]}" = 1 ] && marcados=$((marcados + 1)); done
  if [ $marcados = 0 ]; then
    echo "nenhum projeto marcado; nada mudou."
    return 1
  fi
  gravar
  echo "$marcados projetos salvos em $CONFIG"
}

if [ "${1:-}" = "kill" ]; then
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
    echo "sessão $SESSION fechada"
  else
    echo "nenhuma sessão $SESSION aberta"
  fi
  exit 0
fi

if [ "${1:-}" = "escolher" ]; then
  escolher || exit 0
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "a sessão $SESSION já está aberta; para aplicar: work kill && work"
    exit 0
  fi
  shift
fi

ler_config
if ! algum_projeto_existe; then
  if [ -t 0 ] && [ -t 1 ]; then
    escolher || exit 0
    ler_config
  else
    echo "nenhum projeto de $CONFIG existe no disco."
    echo "rode work escolher num terminal para escolher os seus."
    exit 1
  fi
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  first=1
  for entry in "${windows[@]}"; do
    IFS="|" read -r name dir cmd <<< "$entry"
    dir="$(resolver "$dir")"
    [ -d "$dir" ] || { echo "pulando $name: $dir não existe"; continue; }
    if [ "$first" = 1 ]; then
      tmux new-session -d -s "$SESSION" -n "$name" -c "$dir" ${cmd:+"$cmd"}
      first=0
    else
      tmux new-window -t "$SESSION:" -n "$name" -c "$dir" ${cmd:+"$cmd"}
    fi
  done
  tmux select-window -t "$SESSION:1"
fi

[ $# -gt 0 ] && tmux select-window -t "$SESSION:$1"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
