#!/usr/bin/env bash
# Última execução de cada pipeline listado em ~/.config/workdeck/azure.conf.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_workdeck-azure"
_workdeck_load_azure || exit 1

P="${AZDO_PIPELINE_PROJECT:-}"
[ -z "$P" ] && { echo "AZDO_PIPELINE_PROJECT não está definido"; exit 1; }

line() { # rótulo, json de runs
  python3 -c "
import json,sys
runs=json.loads(sys.argv[2] or '[]')
if not runs: print(f'  {sys.argv[1]:12} sem execução'); sys.exit()
r=runs[0]; res=r.get('result') or r.get('status'); fin=(r.get('finishTime') or r.get('startTime') or '')[:16].replace('T',' ')
mark={'succeeded':'✓','failed':'✗','canceled':'-','partiallySucceeded':'~'}.get(res,'…')
print(f'{mark} {sys.argv[1]:12} {res:12} {fin}')
" "$1" "$2"
}

id_of() { az pipelines show --org "$AZDO_ORG" --project "$P" --name "$1" --query id -o tsv 2>/dev/null; }

for entry in "${AZDO_PIPELINES[@]}"; do
  IFS="|" read -r label pipeline branch <<< "$entry"
  id=$(id_of "$pipeline")
  if [ -z "$id" ]; then line "$label" ""; continue; fi
  if [ -n "${branch:-}" ]; then
    line "$label" "$(az pipelines runs list --org "$AZDO_ORG" --project "$P" --pipeline-ids "$id" --branch "$branch" --top 1 -o json 2>/dev/null)"
  else
    line "$label" "$(az pipelines runs list --org "$AZDO_ORG" --project "$P" --pipeline-ids "$id" --top 1 -o json 2>/dev/null)"
  fi
done
