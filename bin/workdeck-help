#!/usr/bin/env bash
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"
SESSION="${WORKDECK_SESSION:-work}"

b=""; d=""; v=""; a=""; r=""
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  b=$'\033[1m'; d=$'\033[2m'; v=$'\033[32m'; a=$'\033[33m'; r=$'\033[0m'
fi

curto() { case "$1" in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }
titulo() { printf '\n  %s%s%s\n' "$b" "$1" "$r"; }
item() {
  local n
  n=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)
  printf '    %s%*s %s%s%s\n' "$1" $((22 - n)) "" "$d" "$2" "$r"
}
ok() { printf '    %s✓%s %s\n' "$v" "$r" "$1"; }
falta() { printf '    %s!%s %s\n' "$a" "$r" "$1"; }

texto() {
  titulo "Comandos"
  item "work" "abre a sessão, ou volta para ela"
  item "ai" "abre o agente de IA ao lado; ai help explica"
  item "work <janela>" "abre e vai direto para a janela"
  item "work add <caminho>" "acrescenta o projeto como janela; sem caminho, a pasta atual"
item "work escolher" "escolhe de novo os projetos"
  item "work kill" "fecha a sessão inteira"
  item "work review" "revisa o que ainda não foi commitado (ou git review)"
  item "work painel" "abre o painel de contexto"
  item "work agent <cmd>" "define o agente de IA; sem nada, mostra o atual"
  item "work doctor" "diz o que funciona no seu ambiente"
  item "work help" "o menu; work help --texto mostra esta lista"

  titulo "Navegar"
  item "Shift+← / Shift+→" "janela anterior / próxima"
  item "Shift+↑ / Shift+↓" "painel anterior / próximo"
  item "clique na barra" "troca de janela; clique num painel para focar"
  item "Ctrl+b e 1-9" "vai para a janela N"
  item "Ctrl+b e setas" "troca de painel"
  item "Ctrl+b e c" "nova janela"
  item "Ctrl+b e Enter" "divide a tela no sentido que sobra mais espaço"
  item "Ctrl+b e v ou -" "divide ao lado ou embaixo"
  item "Ctrl+b e =" "iguala o tamanho dos painéis"
  item "Ctrl+b e z" "zoom no painel"
  item "Ctrl+b e x" "fecha o painel"
  item "Ctrl+b e a" "abre o agente ao lado"
  item "Ctrl+b e d" "solta a sessão; ela continua viva"
  item "Ctrl+b e h" "o menu, dentro do work"
  printf '    %sCtrl+b quer dizer: aperte Ctrl+b, solte, e depois a tecla.%s\n' "$d" "$r"

  titulo "Seu ambiente"
  projetos=0
  if [ -f "$CONFIG_DIR/projects.conf" ]; then
    projetos=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | grep -c '|' || true)
  fi
  if [ "$projetos" -gt 0 ]; then
    ok "$projetos janelas em $(curto "$CONFIG_DIR/projects.conf")"
  else
    falta "nenhum projeto ainda — adicione com: work add <caminho>"
  fi

  AGENT_CMD=""
  [ -f "$CONFIG_DIR/agent.conf" ] && . "$CONFIG_DIR/agent.conf"
  if [ -n "$AGENT_CMD" ]; then
    ok "agente de IA: $AGENT_CMD"
  else
    falta "nenhum agente de IA configurado. Para ligar um:"
    printf '        1. instale o agente que quiser, pelo método dele (claude, codex, aider, gemini…)\n'
    printf '        2. work agent <comando>\n'
    printf '        3. ai, ou Ctrl+b e a\n'
  fi

  if command -v tmux >/dev/null && tmux has-session -t "$SESSION" 2>/dev/null; then
    ok "sessão $SESSION aberta"
  else
    printf '    %s·%s sessão %s fechada — abra com work\n' "$d" "$r" "$SESSION"
  fi
  echo
}

OPCOES=(
  "w|abrir o work"
  "a|abrir o agente ao lado"
  "e|escolher os projetos"
  "g|definir o agente de IA"
  "r|revisar o que não foi commitado"
  "p|abrir o painel"
  "d|diagnóstico"
  "?|ver todos os comandos e atalhos"
)

sair_da_tela() { printf '\033[?25h\033[?1049l'; trap - EXIT; }

executar() {
  sair_da_tela
  case "$1" in
    w) exec work ;;
    e) exec work escolher ;;
    a) exec workdeck-agent ;;
    g)
      workdeck-agent --list
      echo
      printf '  comando do agente (enter cancela): '
      read -r cmd || cmd=""
      [ -n "$cmd" ] && exec workdeck-agent --set "$cmd"
      exit 0 ;;
    r) exec git-review ;;
    p) exec work painel ;;
    d) exec workdeck-doctor ;;
    '?') texto; exit 0 ;;
  esac
}

menu() {
  local cur=0 n=${#OPCOES[@]} i tecla resto chave rotulo largura
  printf '\033[?1049h\033[?25l'
  trap 'printf "\033[?25h\033[?1049l"' EXIT
  while true; do
    printf '\033[H\033[2J\n  %sworkdeck%s\n  %s↑↓ move · enter executa · a letra executa direto · q sai%s\n\n' "$b" "$r" "$d" "$r"
    for ((i = 0; i < n; i++)); do
      chave="${OPCOES[$i]%%|*}"; rotulo="${OPCOES[$i]#*|}"
      largura=$(printf '%s' "$rotulo" | LC_ALL=C tr -d '\200-\277' | wc -c)
      if [ $i = $cur ]; then
        printf '  \033[7m› %s%*s %s \033[0m\n' "$rotulo" $((38 - largura)) "" "$chave"
      else
        printf '    %s%*s %s%s%s\n' "$rotulo" $((38 - largura)) "" "$d" "$chave" "$r"
      fi
    done
    IFS= read -rsn1 tecla || tecla=q
    case "$tecla" in
      $'\033')
        IFS= read -rsn2 resto || resto=""
        case "$resto" in
          '[A') [ $cur -gt 0 ] && cur=$((cur - 1)) ;;
          '[B') [ $cur -lt $((n - 1)) ] && cur=$((cur + 1)) ;;
        esac ;;
      k) [ $cur -gt 0 ] && cur=$((cur - 1)) ;;
      j) [ $cur -lt $((n - 1)) ] && cur=$((cur + 1)) ;;
      '') executar "${OPCOES[$cur]%%|*}" ;;
      q) sair_da_tela; exit 0 ;;
      *)
        for ((i = 0; i < n; i++)); do
          [ "${OPCOES[$i]%%|*}" = "$tecla" ] && executar "$tecla"
        done ;;
    esac
  done
}

if [ "${1:-}" = "--texto" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
  texto
else
  menu
fi
