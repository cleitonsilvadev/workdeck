#!/usr/bin/env bash
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"
SESSION="${WORKDECK_SESSION:-work}"

b=""; d=""; v=""; a=""; r=""
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  b=$'\033[1m'; d=$'\033[2m'; v=$'\033[32m'; a=$'\033[33m'; r=$'\033[0m'
fi

curto() { case "$1" in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }
titulo() { printf '\n  %s%s%s\n' "$b" "$1" "$r"; }
item() {
  local n
  n=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)
  printf '    %s%*s %s%s%s\n' "$1" $((22 - n)) "" "$d" "$2" "$r"
}
ok() { printf '    %s✓%s %s\n' "$v" "$r" "$1"; }
falta() { printf '    %s!%s %s\n' "$a" "$r" "$1"; }

texto() {
  titulo "Comandos"
  item "work" "abre a sessão, ou volta para ela"
  item "work add <caminho>" "acrescenta o projeto como janela; sem caminho, a pasta atual"
  item "work review" "a IA revisa a mudança num painel embaixo; staged ou branch"
  item "work update" "atualiza para a versão mais nova"

  titulo "Navegar"
  item "Ctrl+b e h" "o menu, dentro do work: projetos, revisar, dividir"
  item "Shift+← / Shift+→" "janela anterior / próxima"
  item "Shift+↑ / Shift+↓" "painel anterior / próximo"
  item "clique na barra" "troca de janela; clique num painel para focar"
  item "Ctrl+b e 1-9" "vai para a janela N"
  item "Ctrl+b e setas" "troca de painel"
  item "Ctrl+b e c" "nova janela"
  item "Ctrl+b e Enter" "divide a tela no sentido que sobra mais espaço"
  item "Ctrl+b e v ou -" "divide ao lado ou embaixo"
  item "Ctrl+b e =" "iguala o tamanho dos painéis"
  item "Ctrl+b e z" "zoom no painel"
  item "Ctrl+b e x" "fecha o painel"
  item "Ctrl+b e d" "solta a sessão; ela continua viva"
  printf '    %sCtrl+b quer dizer: aperte Ctrl+b, solte, e depois a tecla.%s\n' "$d" "$r"

  titulo "Seu ambiente"
  projetos=0
  if [ -f "$CONFIG_DIR/projects.conf" ]; then
    projetos=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | grep -c '|' || true)
  fi
  if [ "$projetos" -gt 0 ]; then
    ok "$projetos janelas em $(curto "$CONFIG_DIR/projects.conf")"
  else
    falta "nenhum projeto ainda — adicione com: work add <caminho>"
  fi

  if command -v tmux >/dev/null && tmux has-session -t "$SESSION" 2>/dev/null; then
    ok "sessão $SESSION aberta"
  else
    printf '    %s·%s sessão %s fechada — abra com work\n' "$d" "$r" "$SESSION"
  fi
  echo
}

texto
