#!/usr/bin/env bash
set -uo pipefail

WORKDECK_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
export WORKDECK_LIB_DIR
. "$WORKDECK_LIB_DIR/common.sh"
WORKDECK_LANG="$(workdeck_language)"
export WORKDECK_LANG
PANELS="$WORKDECK_CONFIG/panels"
INTERVAL=60
ONCE=0

for arg in "$@"; do
  case "$arg" in
    --once) ONCE=1 ;;
    -h|--help) msgln panel_help; exit 0 ;;
    *[!0-9]*) msgln panel_bad_interval "$arg"; exit 1 ;;
    *) INTERVAL="$arg" ;;
  esac
done

bold=$'\e[1;38;5;183m'; reset=$'\e[0m'

panel_title() {
  local key
  key="msg_panel_title_$(basename "$1" | tr -c 'A-Za-z0-9\n' '_')"
  if [ -n "${!key-}" ]; then printf '%s\n' "${!key}"; return 0; fi
  basename "$1" | sed 's/^[0-9]*-//; s/[-_]/ /g' | awk '{print toupper(substr($0,1,1)) substr($0,2)}'
}

draw() {
  if [ ! -d "$PANELS" ]; then
    msgln panel_none
    echo
    msgln panel_create "$PANELS"
    echo
    echo "  mkdir -p \"$PANELS\""
    printf '%s\n' "  printf '#!/usr/bin/env bash\\nuptime\\n' > \"$PANELS/10-uptime\""
    echo "  chmod +x \"$PANELS/10-uptime\""
    return
  fi

  local found=0
  for panel in "$PANELS"/*; do
    [ -x "$panel" ] || continue
    found=1
    case "$(basename "$panel")" in
      00-*) ;;
      *) printf '%s%s%s\n' "$bold" "$(panel_title "$panel")" "$reset" ;;
    esac
    "$panel" 2>&1 | sed 's/^/  /'
    echo
  done

  if [ "$found" = 0 ]; then
    msgln panel_empty "$PANELS"
    msgln panel_chmod
  fi
}

toml_string() {
  local value="${1//\\/\\\\}"
  printf '"%s"' "${value//\"/\\\"}"
}

write_tclock_config() {
  local file="$WORKDECK_CONFIG/tclock/config.toml" panel title accent position compact
  accent="$(tmux show -gqv @wd_accent 2>/dev/null)"
  mkdir -p "$(dirname "$file")"
  {
    # The clock takes the accent of the workdeck theme, and Shift+T stays on it.
    [ -n "$accent" ] && printf '[default]\ncolor = %s\n\n' "$(toml_string "$accent")"
    printf '[clock]\nshow_date = true\nwidget_themes = ["default"]\n'
    for panel in "$PANELS"/*; do
      [ -x "$panel" ] || continue
      title="$(panel_title "$panel")" position=auto compact=0
      case "$(basename "$panel")" in 00-*) title="" position=bottom compact=1 ;; esac
      printf '\n[[clock.widgets]]\ntitle = %s\ncommand = ["/usr/bin/env", %s, %s, %s]\nrefresh_secs = %s\nposition = %s\n' "$(toml_string "$title")" "$(toml_string "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}")" "$(toml_string "WORKDECK_PANEL_COMPACT=$compact")" "$(toml_string "$panel")" "$INTERVAL" "$(toml_string "$position")"
    done
  } > "$file"
}

if [ "$ONCE" = 1 ]; then
  draw
  exit 0
fi

if [ "$(setting_get PANEL_CLOCK no)" = yes ] && [ -d "$PANELS" ] && command -v tclock >/dev/null; then
  write_tclock_config
  XDG_CONFIG_HOME="$WORKDECK_CONFIG" exec tclock
fi

trap 'printf "\e[?25h"; exit 0' INT TERM
printf '\e[?25l'

while true; do
  output="$(draw)"
  printf '\e[H\e[2J%s\n' "$output"
  read -r -t "$INTERVAL" -n 1 key && [ "$key" = "q" ] && break
done

printf '\e[?25h'
