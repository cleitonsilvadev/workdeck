#!/usr/bin/env bash
# work-panel — mostra a saída de vários comandos em um pane, atualizando sozinho.
#
#   work-panel            atualiza a cada 60s
#   work-panel 10         atualiza a cada 10s
#   work-panel --once     imprime uma vez e sai
#
# Cada painel é um executável em ~/.config/workdeck/panels/. O nome do arquivo
# vira o título, e a ordem é alfabética — use um prefixo numérico para ordenar
# (10-maquina, 20-docker). Qualquer coisa que imprima texto serve. Os que
# começam com 00- aparecem sem título.
set -uo pipefail

PANELS="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck/panels"
INTERVAL=60
ONCE=0

for arg in "$@"; do
  case "$arg" in
    --once) ONCE=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *[!0-9]*) echo "intervalo inválido: $arg"; exit 1 ;;
    *) INTERVAL="$arg" ;;
  esac
done

bold=$'\e[1m'; dim=$'\e[2m'; reset=$'\e[0m'

titulo_de() { # 20-docker → Docker
  basename "$1" | sed 's/^[0-9]*-//; s/[-_]/ /g' | awk '{print toupper(substr($0,1,1)) substr($0,2)}'
}

desenha() {
  if [ ! -d "$PANELS" ]; then
    echo "Nenhum painel ainda."
    echo
    echo "Crie um executável em $PANELS/ — qualquer coisa que imprima texto:"
    echo
    echo "  mkdir -p \"$PANELS\""
    echo "  printf '#!/usr/bin/env bash\\nuptime\\n' > \"$PANELS/10-uptime\""
    echo "  chmod +x \"$PANELS/10-uptime\""
    return
  fi

  local achou=0
  for painel in "$PANELS"/*; do
    [ -x "$painel" ] || continue
    achou=1
    case "$(basename "$painel")" in
      00-*) ;;
      *) printf '%s%s%s\n' "$bold" "$(titulo_de "$painel")" "$reset" ;;
    esac
    "$painel" 2>&1 | sed 's/^/  /'
    echo
  done

  if [ "$achou" = 0 ]; then
    echo "$PANELS existe mas não tem nenhum executável."
    echo "Lembre do chmod +x."
  fi
}

if [ "$ONCE" = 1 ]; then
  desenha
  exit 0
fi

trap 'printf "\e[?25h"; exit 0' INT TERM
printf '\e[?25l'                                  # esconde o cursor

while true; do
  saida="$(desenha)"
  printf '\e[H\e[2J%s\n' "$saida"
  read -r -t "$INTERVAL" -n 1 tecla && [ "$tecla" = "q" ] && break
done

printf '\e[?25h'
