set -g @wd_accent "#d0d0d0"
set -g @wd_on_accent "#1a1a1a"
set -g @wd_surface "#383838"
set -g @wd_text "#eaeaea"
set -g @wd_muted "#7e7e7e"
set -g status-style "bg=#1a1a1a,fg=#7e7e7e"
setw -g pane-border-style "fg=#2a2a2a"
setw -g pane-active-border-style "fg=#d0d0d0"
set -g message-style "bg=#383838,fg=#eaeaea,bold"
set -g mode-style "bg=#383838,fg=#eaeaea"
