#!/usr/bin/env bash
. "${WORKDECK_LIB_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/workdeck/lib}/common.sh" 2>/dev/null || msg() { printf '%s' "$1"; }
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"

projects=0
if [ -f "$CONFIG_DIR/projects.conf" ]; then
  projects=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | awk -F'|' 'NF >= 2 && $3 == ""' | wc -l | tr -d ' ')
fi
code="${XDG_DATA_HOME:-$HOME/.local/share}/workdeck"
command -v work >/dev/null && work update --check >/dev/null 2>&1
version="$(git -C "$code" describe --tags --abbrev=0 2>/dev/null || true)"
latest="$(sed -n 's/^latest=//p' "${XDG_CACHE_HOME:-$HOME/.cache}/workdeck/update" 2>/dev/null | tail -1)"

x=$'\033[0m'
purple=$'\033[1;38;5;183m'; dim=$'\033[2m'; yellow=$'\033[33m'; green=$'\033[32m'

if [ "$projects" -gt 0 ]; then
  projects_line="${green}✓${x} $(msg panel_projects)  $projects"
else
  projects_line="${yellow}!${x} $(msg panel_projects)  $(msg panel_projects_zero)"
fi
version_line=""
highest="$(printf '%s\n%s\n' "$latest" "${version:-v0.0.0}" | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | awk -F'[v.]' '{printf "%09d%09d%09d %s\n", $2, $3, $4, $0}' | sort | tail -1 | cut -d' ' -f2)"
if [ -n "$latest" ] && [ "$latest" != "$version" ] && [ "$highest" = "$latest" ]; then
  version_line="${yellow}●${x} ${version:-$(msg panel_no_version)} → $latest: work update"
elif [ -n "$version" ]; then
  version_line="${dim}$version${x}"
fi

text=(
  ""
  ""
  "${purple}workdeck${x}  $version_line"
  "${dim}$(msg panel_tagline)${x}"
  ""
  "$projects_line"
  ""
  ""
  ""
)

print_logo "${text[@]}"
echo

step() {
  local n
  n=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)
  printf '  %s%s%*s%s %s\n' "$purple" "$1" $((22 - n)) "" "$x" "$2"
}

if [ "$projects" = 0 ]; then
  printf '%s\n' "$(msg panel_start "$purple" "$x")"
  step "$(msg panel_add_project)" "$(msg panel_add_project_hint)"
  echo
fi

if [ -n "${TMUX:-}" ] && [ "$(tmux display -p '#{client_termname}' 2>/dev/null)" != xterm-kitty ]; then
  if [ "$(sed -n 's/^TERMINAL="\(.*\)"$/\1/p' "$CONFIG_DIR/settings.conf" 2>/dev/null | head -1)" = kitty ]; then
    printf '%s%s%s\n\n' "$dim" "$(msg panel_kitty_elsewhere)" "$x"
  else
    printf '%s\n\n' "$(msg panel_outside_kitty "$purple" "$x")"
  fi
fi

menu_key="Ctrl+b h"
if [ -n "${TMUX:-}" ]; then
  if [ "$(tmux display -p '#{client_termname}' 2>/dev/null)" = xterm-kitty ]; then
    if [ "$(uname -s)" = Darwin ]; then menu_key="⌘H"; else menu_key="Ctrl+Shift+H"; fi
  fi
fi
printf '%s%s%s\n' "$dim" "$(msg panel_menu_hint "$menu_key")" "$x"

custom=0
for f in "$CONFIG_DIR"/panels/*; do
  case "$(basename "$f")" in 00-workdeck|20-projetos) continue ;; esac
  [ -x "$f" ] && custom=$((custom + 1))
done
if [ "$custom" = 0 ]; then
  printf '%s%s%s\n' "$dim" "$(msg panel_custom_hint)" "$x"
  printf '%s%s%s\n' "$dim" "$(msg panel_guide)" "$x"
fi
