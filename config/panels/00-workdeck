#!/usr/bin/env bash
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"

projetos=0
if [ -f "$CONFIG_DIR/projects.conf" ]; then
  projetos=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | awk -F'|' 'NF >= 2 && $3 == ""' | wc -l | tr -d ' ')
fi
codigo="${XDG_DATA_HOME:-$HOME/.local/share}/workdeck"
command -v work >/dev/null && work update --verificar >/dev/null 2>&1
versao="$(git -C "$codigo" describe --tags --abbrev=0 2>/dev/null || true)"
nova="$(sed -n 's/^nova=//p' "${XDG_CACHE_HOME:-$HOME/.cache}/workdeck/atualizacao" 2>/dev/null | tail -1)"

m=$'\033[48;5;183m'; e=$'\033[48;5;234m'; x=$'\033[0m'
roxo=$'\033[1;38;5;183m'; dim=$'\033[2m'; amarelo=$'\033[33m'; verde=$'\033[32m'

desenho=(
  ".MMMMMMMMM."
  "MMMMMMMMMMM"
  "MMEMMMMMMMM"
  "MMMEMMMMMMM"
  "MMMMEMMMMMM"
  "MMMEMMMMMMM"
  "MMEMMEEEEMM"
  "MMMMMMMMMMM"
  ".MMMMMMMMM."
)

if [ "$projetos" -gt 0 ]; then
  linha_projetos="${verde}✓${x} projetos  $projetos"
else
  linha_projetos="${amarelo}!${x} projetos  nenhum ainda"
fi
linha_versao=""
maior="$(printf '%s\n%s\n' "$nova" "${versao:-v0.0.0}" | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | awk -F'[v.]' '{printf "%09d%09d%09d %s\n", $2, $3, $4, $0}' | sort | tail -1 | cut -d' ' -f2)"
if [ -n "$nova" ] && [ "$nova" != "$versao" ] && [ "$maior" = "$nova" ]; then
  linha_versao="${amarelo}●${x} ${versao:-sem versão} → $nova: work update"
elif [ -n "$versao" ]; then
  linha_versao="${dim}$versao${x}"
fi

texto=(
  ""
  ""
  "${roxo}workdeck${x}  $linha_versao"
  "${dim}terminal para agentes de IA${x}"
  ""
  "$linha_projetos"
  ""
  ""
  ""
)

for ((i = 0; i < ${#desenho[@]}; i++)); do
  linha=""
  row="${desenho[$i]}"
  for ((j = 0; j < ${#row}; j++)); do
    case "${row:$j:1}" in
      M) linha="$linha$m  " ;;
      E) linha="$linha$e  " ;;
      *) linha="$linha$x  " ;;
    esac
  done
  printf '%s%s   %s\n' "$linha" "$x" "${texto[$i]}"
done
echo

passo() {
  local n
  n=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)
  printf '  %s%s%*s%s %s\n' "$roxo" "$1" $((22 - n)) "" "$x" "$2"
}

if [ "$projetos" = 0 ]; then
  printf '%sPara começar%s, no terminal aqui embaixo:\n' "$roxo" "$x"
  passo "work add ~/projeto" "cada projeto vira uma janela; Tab completa o caminho"
  echo
fi

if [ -n "${TMUX:-}" ] && [ "$(tmux display -p '#{client_termname}' 2>/dev/null)" != xterm-kitty ]; then
  printf '%sFora do kitty%s: o work funciona, mas o tema, a fonte e os atalhos cmd só valem lá.\n\n' "$roxo" "$x"
fi

printf '%sComandos%s\n' "$roxo" "$x"
passo "work" "abre a sessão, ou volta para ela"
passo "work add ~/projeto" "acrescenta um projeto; Tab completa o caminho"
passo "work review" "a IA revisa a mudança antes do commit, num painel embaixo"
passo "work update" "atualiza o workdeck"
echo

printf '%sO dia a dia%s\n' "$roxo" "$x"
passo "Ctrl+b h" "o menu: projetos, revisar, dividir a tela e mais"
passo "Shift+← / →" "vai para o projeto anterior / próximo"
passo "Ctrl+b Enter" "divide a tela; v ao lado, - embaixo, = iguala"
passo "Shift+↑ / ↓" "troca de painel dentro da janela"
passo "Ctrl+b z · Ctrl+b x" "zoom no painel · fecha o painel"
