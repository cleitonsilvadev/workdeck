#!/usr/bin/env bash
# Em que branch está cada projeto do seu projects.conf, e se há mudança solta.
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck/projects.conf"
[ -f "$CONFIG" ] || { echo "sem projects.conf"; exit 0; }

while IFS= read -r line; do
  line="${line%%#*}"; [ -z "${line// }" ] && continue
  IFS="|" read -r nome dir _ <<< "$line"
  dir="$(eval echo "${dir/#\~/$HOME}")"
  [ -d "$dir/.git" ] || continue
  branch=$(git -C "$dir" branch --show-current 2>/dev/null)
  sujo=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "$sujo" -gt 0 ]; then
    printf '%-14s %s  (%s alterado(s))\n' "$nome" "${branch:-?}" "$sujo"
  else
    printf '%-14s %s\n' "$nome" "${branch:-?}"
  fi
done < "$CONFIG"
