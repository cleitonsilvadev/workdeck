#!/usr/bin/env bash
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"
projetos=0
if [ -f "$CONFIG_DIR/projects.conf" ]; then
  projetos=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | awk -F'|' 'NF >= 2 && $3 == ""' | wc -l | tr -d ' ')
fi
AGENT_CMD=""
[ -f "$CONFIG_DIR/agent.conf" ] && . "$CONFIG_DIR/agent.conf"

if [ "$projetos" = 0 ]; then
  echo "Adicione seus projetos; cada um vira uma janela:"
  echo
  echo "  work add ~/caminho/do/projeto     Tab completa o caminho"
  echo
fi
if [ -z "$AGENT_CMD" ]; then
  echo "Ligue um agente de IA:  work agent <comando>   (claude, codex, aider…)"
  echo
fi
echo "Shift+←/→ janelas · Shift+↑/↓ painéis · Ctrl+b h menu"
